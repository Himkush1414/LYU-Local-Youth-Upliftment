# Supabase (from supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# OpenAI (platform.openai.com — $5 free credit on signup)
OPENAI_API_KEY=sk-...

# Adzuna Jobs API (free at developer.adzuna.com)
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# JSearch via RapidAPI (free tier at rapidapi.com)
JSEARCH_API_KEY=your_rapidapi_key

# Resend Email (free 3000 emails/month at resend.com)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notifications@lyu.in

# Web Push (generate free: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@lyu.in

# Upstash Redis (free tier at upstash.com — 10k req/day free)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Twilio (optional — $15 free trial at twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
